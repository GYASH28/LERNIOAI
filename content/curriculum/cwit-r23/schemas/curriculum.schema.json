{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lernio.local/schemas/cwit-r23-curriculum.schema.json",
  "title": "CWIT R23 Curriculum Manifest",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "manifestVersion",
    "institutionCode",
    "departmentCode",
    "programmeCode",
    "officialProgrammeCode",
    "schemeCode",
    "schemeRevision",
    "semesterNumber",
    "status",
    "verificationStatus",
    "sourceReferences",
    "subjects"
  ],
  "properties": {
    "manifestVersion": { "type": "integer", "minimum": 1 },
    "institutionCode": { "type": "string", "minLength": 1 },
    "departmentCode": { "type": "string", "minLength": 1 },
    "programmeCode": { "type": "string", "minLength": 1 },
    "officialProgrammeCode": { "type": "string", "minLength": 1 },
    "schemeCode": { "type": "string", "minLength": 1 },
    "schemeRevision": { "type": "string", "minLength": 1 },
    "semesterNumber": { "type": "integer", "minimum": 1, "maximum": 6 },
    "status": { "type": "string", "enum": ["draft", "ready_for_import", "published"] },
    "verificationStatus": {
      "type": "string",
      "enum": ["draft", "needs_official_source", "structure_verified", "content_verified", "published"]
    },
    "sourceReferences": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/sourceReference" }
    },
    "manifestNotes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "subjects": {
      "type": "array",
      "items": { "$ref": "#/$defs/subject" }
    }
  },
  "$defs": {
    "sourceReference": {
      "type": "object",
      "additionalProperties": true,
      "required": ["sourceId"],
      "properties": {
        "sourceId": { "type": "string", "minLength": 1 },
        "title": { "type": "string" },
        "sourceUrl": { "type": "string" },
        "localPath": { "type": "string" },
        "pages": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1 }
        },
        "evidence": { "type": "string" }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "order",
        "officialSubjectCode",
        "name",
        "category",
        "assessment",
        "units",
        "outcomes",
        "practicalExperiments",
        "sourceReferences",
        "verificationStatus"
      ],
      "properties": {
        "order": { "type": "integer", "minimum": 1 },
        "officialSubjectCode": { "type": "string", "pattern": "^R23(CP|CI)[0-9]{4}$" },
        "name": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "credits": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "assessment": {
          "type": "object",
          "additionalProperties": true,
          "required": ["totalMarks"],
          "properties": {
            "totalMarks": { "type": "integer", "minimum": 1 }
          }
        },
        "units": {
          "type": "array",
          "items": { "$ref": "#/$defs/unit" }
        },
        "outcomes": {
          "type": "array",
          "items": { "type": "object" }
        },
        "practicalExperiments": {
          "type": "array",
          "items": { "type": "object" }
        },
        "sourceReferences": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sourceReference" }
        },
        "verificationStatus": {
          "type": "string",
          "enum": ["draft", "needs_official_source", "structure_verified", "content_verified", "published"]
        },
        "notes": { "type": "string" }
      }
    },
    "unit": {
      "type": "object",
      "additionalProperties": true,
      "required": ["order", "title", "topics", "sourceReferences", "verificationStatus"],
      "properties": {
        "order": { "type": "integer", "minimum": 1 },
        "title": { "type": "string", "minLength": 1 },
        "topics": {
          "type": "array",
          "items": { "$ref": "#/$defs/topic" }
        },
        "sourceReferences": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sourceReference" }
        },
        "verificationStatus": {
          "type": "string",
          "enum": ["draft", "needs_official_source", "structure_verified", "content_verified", "published"]
        }
      }
    },
    "topic": {
      "type": "object",
      "additionalProperties": true,
      "required": ["order", "title", "sourceReferences", "verificationStatus"],
      "properties": {
        "order": { "type": "integer", "minimum": 1 },
        "title": { "type": "string", "minLength": 1 },
        "sourceReferences": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sourceReference" }
        },
        "verificationStatus": {
          "type": "string",
          "enum": ["draft", "needs_official_source", "structure_verified", "content_verified", "published"]
        }
      }
    }
  }
}
