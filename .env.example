# Database
# Local development can use a normal PostgreSQL URL:
# DATABASE_URL="postgresql://lernio:lernio_password@localhost:5432/lernio?schema=public"
#
# Vercel/Supabase runtime should use the transaction pooler on port 6543.
# Replace placeholders; never commit the real password or project reference.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Prisma migrations must use a direct or session-pooler connection on port 5432.
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"
# Legacy migration URL aliases accepted by scripts/db-deploy.mjs.
DATABASE_URL_UNPOOLED=""
POSTGRES_URL_NON_POOLING=""
# Avoid false database outages during normal serverless cold starts.
PRISMA_CONNECT_TIMEOUT_SECONDS="10"
PRISMA_POOL_TIMEOUT_SECONDS="10"
DATABASE_TCP_PROBE_TIMEOUT_MS="1500"
DATABASE_REACHABILITY_CACHE_MS="5000"

# Database maintenance safety
# Vercel builds never migrate or seed the database. Run the explicit release
# commands separately. Keep both opt-ins false except for a deliberate one-off run.
LERNIO_ALLOW_DB_SEED="false"
LERNIO_ALLOW_ADMIN_UPSERT="false"

# Demo mode
# Set true only for local/demo environments. Production must be false.
LERNIO_DEMO_MODE="false"
LERNIO_DEMO_PASSWORD=""
NEXT_PUBLIC_LERNIO_ROLL_NUMBER_PATTERN="^[A-Za-z0-9/-]{1,32}$"

# Admin bootstrap for `npm run db:deploy:admin`.
LERNIO_ADMIN_EMAIL=""
LERNIO_ADMIN_PASSWORD=""

# Auth.js / NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# AI provider settings
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"
GROQ_FAST_MODEL="llama-3.1-8b-instant"
GROQ_TIMEOUT_MS="28000"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash"
GEMINI_FAST_MODEL="gemini-3.5-flash-lite"
GEMINI_TIMEOUT_MS="45000"
AI_QUALITY_PROVIDER="gemini"
AI_FAST_PROVIDER="groq"

# YouTube Data API is optional. Without it, playlist candidates remain manual-review only.
YOUTUBE_API_KEY=""

# Object storage for reviewed notes/PDFs. Do not expose private object keys to clients.
STORAGE_PROVIDER=""
STORAGE_BUCKET=""
STORAGE_PUBLIC_BASE_URL=""
STORAGE_SIGNING_SECRET=""
STORAGE_SIGNED_URL_TTL_SECONDS="900"

# Lesson-note generation worker. Run manually with `npm run notes:generate:work -- --limit 1`.
# The provider must return a LessonNoteDocument JSON payload; the artifact store must write HTML/PDF objects.
LESSON_NOTE_GENERATOR_URL=""
LESSON_NOTE_GENERATOR_TOKEN=""
LESSON_NOTE_GENERATOR_PROVIDER=""
LESSON_NOTE_GENERATOR_MODEL=""
LESSON_NOTE_GENERATOR_TIMEOUT_MS="45000"
LESSON_NOTE_ARTIFACT_STORE_URL=""
LESSON_NOTE_ARTIFACT_STORE_TOKEN=""
LESSON_NOTE_ARTIFACT_STORE_TIMEOUT_MS="45000"

# Trusted code-runner service for Coding Lab submissions. The Next.js app does not execute student code.
CODE_RUNNER_URL=""
CODE_RUNNER_TOKEN=""
CODE_RUNNER_HMAC_SECRET=""

# Transactional email for verification and password reset.
RESEND_API_KEY=""
EMAIL_FROM="Lernio <no-reply@your-domain.example>"
