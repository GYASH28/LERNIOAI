# Database
# Production uses PostgreSQL. Keep SQLite only for disposable local/demo fixtures.
DATABASE_URL="postgresql://lernio:lernio_password@localhost:5432/lernio?schema=public"
# Optional direct/unpooled URL for running Prisma migrations on Vercel.
DATABASE_URL_UNPOOLED=""
# Keep disconnected database attempts from freezing navigation for several seconds.
PRISMA_CONNECT_TIMEOUT_SECONDS="2"
PRISMA_POOL_TIMEOUT_SECONDS="2"
DATABASE_TCP_PROBE_TIMEOUT_MS="350"
DATABASE_REACHABILITY_CACHE_MS="2000"

# Demo mode
# Set true only for local/demo environments. Production must be false.
LERNIO_DEMO_MODE="false"
LERNIO_DEMO_PASSWORD="student123"
NEXT_PUBLIC_LERNIO_ROLL_NUMBER_PATTERN="^[A-Za-z0-9/-]{1,32}$"

# Admin bootstrap for `npm run db:seed`.
LERNIO_ADMIN_EMAIL="ultimatebracegaming@gmail.com"
LERNIO_ADMIN_PASSWORD=""

# Auth.js / NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# AI provider settings
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"
GROQ_FAST_MODEL="llama-3.1-8b-instant"
GROQ_TIMEOUT_MS="28000"

# Transactional email for verification and password reset.
RESEND_API_KEY=""
EMAIL_FROM="Lernio <no-reply@your-domain.example>"
