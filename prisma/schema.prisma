// Idempotent XP ledger — server-authoritative, never client-writable.
// Total XP = sum of all XpEvent.amount for a user (cached on User.xp).
model XpEvent {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  eventType      String // lesson_complete | question_correct | question_attempt | quiz_submit | revision | coding_pass | achievement | contribution | streak
  sourceId       String? // id of the originating resource (lessonId, questionId, attemptId, achievementId, etc.)
  amount         Int // can be negative for corrections
  idempotencyKey String   @unique // prevents double-awarding for the same event
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, eventType])
}

model UserTopicMastery {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  topicId       String
  topic         Topic     @relation(fields: [topicId], references: [id])
  score         Float     @default(0) // 0-100
  state         String    @default("new") // new | learning | weak | revising | proficient | mastered
  evidenceCount Int       @default(0)
  confidence    Float     @default(0)
  lastPractised DateTime?
  nextRevision  DateTime?
  algoVersion   Int       @default(1)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([userId, topicId])
}

model LessonCompletion {
