// Lernio AI 2.0 — Prisma Schema
// Comprehensive academic learning platform data model

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ACADEMIC HIERARCHY
// ============================================================

model Institution {
  id                  String                  @id @default(cuid())
  name                String
  code                String                  @unique
  city                String?
  createdAt           DateTime                @default(now())
  departments         Department[]
  schemes             AcademicScheme[]
  courseCatalog       CourseCatalog[]
  memberships         InstitutionMembership[]
  classGroups         ClassGroup[]
  authorityGrants     AuthorityGrant[]
  roleAssignments     RoleAssignment[]
  teachingAssignments TeachingAssignment[]
  auditEvents         AuditEvent[]
}

model Department {
  id                  String               @id @default(cuid())
  name                String               @default("")
  code                String
  institutionId       String
  institution         Institution          @relation(fields: [institutionId], references: [id])
  officialUrl         String?
  category            String?
  status              String               @default("active")
  metadata            String?
  sourceVerifiedAt    DateTime?
  archivedAt          DateTime?
  programmes          Programme[]
  classGroups         ClassGroup[]
  authorityGrants     AuthorityGrant[]
  roleAssignments     RoleAssignment[]
  teachingAssignments TeachingAssignment[]
  auditEvents         AuditEvent[]
  createdAt           DateTime             @default(now())

  @@unique([institutionId, code])
}

model Programme {
  id                String           @id @default(cuid())
  name              String
  code              String
  departmentId      String
  department        Department       @relation(fields: [departmentId], references: [id])
  durationSemesters Int?
  status            String           @default("active")
  intake            Int?
  intakeNote        String?
  metadata          String?
  archivedAt        DateTime?
  schemes           AcademicScheme[]
  classGroups       ClassGroup[]
  authorityGrants   AuthorityGrant[]
  roleAssignments   RoleAssignment[]
  createdAt         DateTime         @default(now())

  @@unique([departmentId, code])
}

model AcademicScheme {
  id                 String           @id @default(cuid())
  name               String // e.g. "G Scheme 2023"
  code               String
  institutionId      String
  institution        Institution      @relation(fields: [institutionId], references: [id])
  programmeId        String?
  programme          Programme?       @relation(fields: [programmeId], references: [id])
  startYear          Int
  endYear            Int?
  revisionLabel      String?
  status             String           @default("draft")
  effectiveFrom      DateTime?
  effectiveTo        DateTime?
  publishedVersionId String?
  sourceCoverage     String?
  archivedAt         DateTime?
  semesters          Semester[]
  subjects           Subject[]
  classGroups        ClassGroup[]
  authorityGrants    AuthorityGrant[]
  roleAssignments    RoleAssignment[]
  createdAt          DateTime         @default(now())
}

model Semester {
  id              String           @id @default(cuid())
  number          Int
  name            String // "Semester 3"
  subtitle        String?
  color           String           @default("#7c3aed")
  schemeId        String
  scheme          AcademicScheme   @relation(fields: [schemeId], references: [id])
  subjects        Subject[]
  classGroups     ClassGroup[]
  authorityGrants AuthorityGrant[]
  roleAssignments RoleAssignment[]
  createdAt       DateTime         @default(now())

  @@unique([schemeId, number])
}

// ============================================================
// SUBJECTS, UNITS, TOPICS
// ============================================================

model Subject {
  id                    String                 @id @default(cuid())
  code                  String // e.g. "CS201"
  name                  String // e.g. "Data Structures"
  shortName             String?
  courseCatalogId       String?
  courseCatalog         CourseCatalog?         @relation(fields: [courseCatalogId], references: [id], onDelete: SetNull)
  credits               Int                    @default(4)
  category              String?
  displayOrder          Int                    @default(0)
  lectureHours          Int?
  tutorialHours         Int?
  practicalHours        Int?
  totalHours            Int?
  assessmentMetadata    String?
  electiveGroupId       String?
  electiveGroup         ElectiveGroup?         @relation(fields: [electiveGroupId], references: [id], onDelete: SetNull)
  sourceEvidence        String?
  status                String                 @default("active")
  reviewStatus          String                 @default("draft")
  publishedAt           DateTime?
  archivedAt            DateTime?
  icon                  String?
  accentColor           String                 @default("#7c3aed")
  mascotKey             String? // leo | byte | coda | pico | nova
  description           String?
  semesterId            String
  semester              Semester               @relation(fields: [semesterId], references: [id])
  schemeId              String
  scheme                AcademicScheme         @relation(fields: [schemeId], references: [id])
  units                 Unit[]
  questions             Question[]
  resources             Resource[]
  codingChallenges      CodingChallenge[]
  codingSubmissions     CodingSubmission[]
  electiveOptions       ElectiveOption[]
  electiveSelections    StudentElectiveSelection[]
  classElectiveAllocations ClassElectiveAllocation[]
  courseOutcomes        CourseOutcome[]
  practicalExperiments  PracticalExperiment[]
  recommendedReferences RecommendedReference[]
  roleAssignments       RoleAssignment[]
  authorityGrants       AuthorityGrant[]
  teachingAssignments   TeachingAssignment[]
  createdAt             DateTime               @default(now())

  @@unique([schemeId, code])
  @@index([courseCatalogId])
  @@index([electiveGroupId])
  @@index([schemeId, status])
  @@index([schemeId, semesterId, displayOrder])
}

model Unit {
  id                    String                 @id @default(cuid())
  number                Int
  title                 String
  description           String?
  weightage             Int                    @default(0) // exam weightage %
  outcomes              String?
  sourceEvidence        String?
  status                String                 @default("active")
  reviewStatus          String                 @default("draft")
  publishedAt           DateTime?
  reviewedById          String?
  publishedById         String?
  version               Int                    @default(1)
  archivedAt            DateTime?
  subjectId             String
  subject               Subject                @relation(fields: [subjectId], references: [id])
  topics                Topic[]
  lessons               Lesson[]
  practicalExperiments  PracticalExperiment[]
  recommendedReferences RecommendedReference[]
  codingChallenges      CodingChallenge[]
  codingSubmissions     CodingSubmission[]
  createdAt             DateTime               @default(now())

  @@unique([subjectId, number])
  @@index([subjectId, status, reviewStatus])
}

model Topic {
  id                    String                 @id @default(cuid())
  slug                  String
  title                 String
  description           String?
  difficulty            String                 @default("medium") // easy | medium | hard
  examWeightage         Int                    @default(0)
  prerequisites         String? // JSON array of topic IDs
  outcomes              String?
  sourceEvidence        String?
  status                String                 @default("active")
  reviewStatus          String                 @default("draft")
  publishedAt           DateTime?
  reviewedById          String?
  publishedById         String?
  version               Int                    @default(1)
  archivedAt            DateTime?
  unitId                String
  unit                  Unit                   @relation(fields: [unitId], references: [id])
  lessons               Lesson[]
  questions             Question[]
  resourceMappings      ResourceTopicMapping[]
  recommendedReferences RecommendedReference[]
  codingChallenges      CodingChallenge[]
  codingSubmissions     CodingSubmission[]
  mastery               UserTopicMastery[]
  revision              RevisionSchedule[]
  createdAt             DateTime               @default(now())

  @@unique([unitId, slug])
  @@index([unitId, status, reviewStatus])
}

// ============================================================
// CWIT LEARNING OS DATA FOUNDATION
// ============================================================

model CourseCatalog {
  id             String       @id @default(cuid())
  institutionId  String?
  institution    Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  canonicalTitle String
  discipline     String?
  description    String?
  keywords       String?
  aliases        String?
  active         Boolean      @default(true)
  sourceEvidence String?
  subjects       Subject[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([institutionId, canonicalTitle])
  @@index([discipline, active])
}

model ElectiveGroup {
  id             String           @id @default(cuid())
  institutionId  String?
  departmentId   String?
  programmeId    String?
  schemeId       String?
  semesterId     String?
  name           String
  code           String?
  minSelect      Int              @default(1)
  maxSelect      Int              @default(1)
  status         String           @default("draft")
  sourceEvidence String?
  subjects       Subject[]
  options        ElectiveOption[]
  studentSelections StudentElectiveSelection[]
  classAllocations  ClassElectiveAllocation[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([schemeId, semesterId, status])
  @@index([programmeId, status])
}

model ElectiveOption {
  id              String        @id @default(cuid())
  electiveGroupId String
  electiveGroup   ElectiveGroup @relation(fields: [electiveGroupId], references: [id], onDelete: Cascade)
  subjectId       String?
  subject         Subject?      @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  label           String
  code            String?
  order           Int           @default(0)
  status          String        @default("active")
  sourceEvidence  String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([electiveGroupId, code])
  @@index([subjectId])
}

model SubjectApplicability {
  id                String   @id @default(cuid())
  subjectId         String
  institutionId     String?
  departmentId      String?
  programmeId       String?
  schemeId          String?
  semesterId        String?
  classGroupId      String?
  applicabilityType String   @default("offering") // offering | foundation | shared | elective
  status            String   @default("active")
  sourceEvidence    String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([subjectId, status])
  @@index([programmeId, schemeId, semesterId])
}

model StudentElectiveSelection {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  electiveGroupId String
  electiveGroup   ElectiveGroup @relation(fields: [electiveGroupId], references: [id], onDelete: Cascade)
  subjectId       String
  subject         Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  status          String        @default("active")
  selectedAt      DateTime      @default(now())
  selectedById    String?
  sourceEvidence  String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([userId, electiveGroupId])
  @@index([subjectId, status])
  @@index([electiveGroupId, status])
}

model ClassElectiveAllocation {
  id              String        @id @default(cuid())
  classGroupId    String
  classGroup      ClassGroup    @relation(fields: [classGroupId], references: [id], onDelete: Cascade)
  electiveGroupId String
  electiveGroup   ElectiveGroup @relation(fields: [electiveGroupId], references: [id], onDelete: Cascade)
  subjectId       String
  subject         Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  status          String        @default("active")
  effectiveFrom   DateTime?
  effectiveTo     DateTime?
  allocatedById   String?
  sourceEvidence  String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([classGroupId, electiveGroupId])
  @@index([subjectId, status])
  @@index([electiveGroupId, status])
}

model CourseOutcome {
  id             String   @id @default(cuid())
  subjectId      String
  subject        Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  code           String
  text           String
  order          Int      @default(0)
  bloomLevel     String?
  sourceEvidence String?
  status         String   @default("draft")
  version        Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([subjectId, code])
  @@index([subjectId, status])
}

model ProgrammeOutcome {
  id             String   @id @default(cuid())
  programmeId    String
  code           String
  text           String
  order          Int      @default(0)
  sourceEvidence String?
  status         String   @default("active")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([programmeId, code])
  @@index([programmeId, status])
}

model OutcomeMapping {
  id                 String   @id @default(cuid())
  courseOutcomeId    String?
  programmeOutcomeId String?
  subjectId          String?
  strength           String   @default("introduced") // introduced | reinforced | mastered
  sourceEvidence     String?
  status             String   @default("draft")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([courseOutcomeId])
  @@index([programmeOutcomeId])
  @@index([subjectId, status])
}

model PracticalExperiment {
  id             String   @id @default(cuid())
  subjectId      String
  subject        Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  unitId         String?
  unit           Unit?    @relation(fields: [unitId], references: [id], onDelete: SetNull)
  title          String
  objective      String?
  apparatus      String?
  software       String?
  procedure      String?
  resultRubric   String?
  safety         String?
  order          Int      @default(0)
  sourceEvidence String?
  status         String   @default("draft")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([subjectId, status])
  @@index([unitId])
}

model RecommendedReference {
  id             String   @id @default(cuid())
  subjectId      String
  subject        Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  unitId         String?
  unit           Unit?    @relation(fields: [unitId], references: [id], onDelete: SetNull)
  topicId        String?
  topic          Topic?   @relation(fields: [topicId], references: [id], onDelete: SetNull)
  title          String
  author         String?
  publisher      String?
  edition        String?
  isbn           String?
  url            String?
  referenceType  String   @default("book")
  sourceEvidence String?
  status         String   @default("active")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([subjectId, status])
  @@index([topicId])
}

model SyllabusDocument {
  id            String              @id @default(cuid())
  institutionId String
  departmentId  String?
  programmeId   String?
  schemeId      String?
  title         String
  sourceType    String
  sourceUrl     String?
  objectKey     String?
  revisionLabel String?
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  checksum      String?
  mimeType      String?
  pageCount     Int?
  trustLevel    String              @default("official")
  status        String              @default("registered")
  uploadedById  String?
  approvedById  String?
  approvedAt    DateTime?
  notes         String?
  snapshots     SourceSnapshot[]
  importJobs    SyllabusImportJob[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([institutionId, status])
  @@index([departmentId, status])
  @@index([programmeId, schemeId])
  @@index([checksum])
}

model SourceSnapshot {
  id                 String           @id @default(cuid())
  syllabusDocumentId String
  syllabusDocument   SyllabusDocument @relation(fields: [syllabusDocumentId], references: [id], onDelete: Cascade)
  sourceUrl          String?
  objectKey          String?
  checksum           String
  mimeType           String?
  byteSize           Int?
  pageCount          Int?
  fetchStatus        String           @default("stored")
  fetchMetadata      String?
  fetchedAt          DateTime         @default(now())
  createdById        String?

  @@unique([syllabusDocumentId, checksum])
  @@index([checksum])
  @@index([fetchStatus, fetchedAt])
}

model SyllabusImportJob {
  id                  String           @id @default(cuid())
  syllabusDocumentId  String
  syllabusDocument    SyllabusDocument @relation(fields: [syllabusDocumentId], references: [id], onDelete: Cascade)
  sourceSnapshotId    String?
  state               String           @default("queued")
  parserVersion       String
  attemptCount        Int              @default(0)
  leaseOwner          String?
  leaseUntil          DateTime?
  logs                String?
  warnings            String?
  errorCode           String?
  extractedJson       String?
  normalizedDraftJson String?
  resultSummary       String?
  requestedById       String?
  reviewedById        String?
  reviewedAt          DateTime?
  findings            ImportFinding[]
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([state, updatedAt])
  @@index([syllabusDocumentId, createdAt])
}

model ImportFinding {
  id               String            @id @default(cuid())
  importJobId      String
  importJob        SyllabusImportJob @relation(fields: [importJobId], references: [id], onDelete: Cascade)
  severity         String            @default("warning")
  code             String
  message          String
  pageNumber       Int?
  rowKey           String?
  fieldPath        String?
  confidence       Float?
  resolutionStatus String            @default("open")
  resolvedById     String?
  resolvedAt       DateTime?
  createdAt        DateTime          @default(now())

  @@index([importJobId, severity])
  @@index([resolutionStatus])
}

model CurriculumVersion {
  id               String    @id @default(cuid())
  institutionId    String
  departmentId     String?
  programmeId      String?
  schemeId         String?
  subjectId        String?
  version          Int       @default(1)
  status           String    @default("draft")
  parentVersionId  String?
  sourceSnapshotId String?
  semanticDiffJson String?
  changeSummary    String?
  createdById      String?
  submittedById    String?
  reviewedById     String?
  publishedById    String?
  submittedAt      DateTime?
  reviewedAt       DateTime?
  publishedAt      DateTime?
  archivedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([schemeId, subjectId, version])
  @@index([schemeId, status])
  @@index([subjectId, status])
}

model ResourceTopicMapping {
  id                 String    @id @default(cuid())
  resourceId         String
  resource           Resource  @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  topicId            String
  topic              Topic     @relation(fields: [topicId], references: [id], onDelete: Cascade)
  coverageType       String    @default("explains")
  coveragePercent    Int?
  priority           Int       @default(0)
  startOffsetSeconds Int?
  endOffsetSeconds   Int?
  mappingNote        String?
  status             String    @default("pending")
  reviewerEvidence   String?
  reviewedById       String?
  reviewedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([resourceId, topicId, coverageType])
  @@index([topicId, status])
  @@index([resourceId, status])
}

model ResourceProvider {
  id                String    @id @default(cuid())
  institutionId     String?
  key               String
  name              String
  providerType      String
  baseUrl           String?
  policyJson        String?
  status            String    @default("active")
  lastHealthCheckAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([institutionId, key])
  @@index([status])
}

model ResourceReview {
  id         String   @id @default(cuid())
  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  reviewerId String?
  decision   String   @default("pending")
  rubricJson String?
  note       String?
  evidence   String?
  createdAt  DateTime @default(now())

  @@index([resourceId, createdAt])
  @@index([decision, createdAt])
}

model ReviewDecision {
  id          String   @id @default(cuid())
  entityType  String
  entityId    String
  reviewerId  String?
  decision    String
  note        String?
  rubricJson  String?
  priorStatus String?
  nextStatus  String?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([decision, createdAt])
}

model AssessmentBlueprint {
  id                       String   @id @default(cuid())
  subjectId                String
  title                    String
  unitScopeJson            String?
  difficultyDistribution   String?
  marksDistribution        String?
  questionTypeDistribution String?
  outcomeScopeJson         String?
  validationSummary        String?
  status                   String   @default("draft")
  createdById              String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@index([subjectId, status])
}

model FormalAssessment {
  id            String    @id @default(cuid())
  blueprintId   String?
  subjectId     String
  title         String
  status        String    @default("draft")
  opensAt       DateTime?
  closesAt      DateTime?
  snapshotJson  String?
  createdById   String?
  publishedById String?
  publishedAt   DateTime?
  archivedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([subjectId, status])
  @@index([opensAt, closesAt])
}

model AssessmentAssignment {
  id           String    @id @default(cuid())
  assessmentId String
  classGroupId String?
  userId       String?
  status       String    @default("assigned")
  assignedById String?
  assignedAt   DateTime  @default(now())
  dueAt        DateTime?

  @@index([assessmentId, status])
  @@index([classGroupId, status])
  @@index([userId, status])
}

model Notice {
  id              String           @id @default(cuid())
  title           String
  body            String
  authorId        String?
  status          String           @default("draft")
  startsAt        DateTime?
  expiresAt       DateTime?
  audienceTargets AudienceTarget[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([status, startsAt])
}

model AudienceTarget {
  id            String  @id @default(cuid())
  noticeId      String
  notice        Notice  @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  institutionId String?
  departmentId  String?
  programmeId   String?
  schemeId      String?
  semesterId    String?
  classGroupId  String?
  subjectId     String?
  role          String?

  @@index([noticeId])
  @@index([institutionId, role])
}

model JobRun {
  id           String    @id @default(cuid())
  key          String
  jobType      String
  state        String    @default("queued")
  attemptCount Int       @default(0)
  leaseOwner   String?
  leaseUntil   DateTime?
  inputJson    String?
  outputJson   String?
  errorCode    String?
  logs         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([jobType, state])
  @@index([state, updatedAt])
}

model IntegrationHealth {
  id          String   @id @default(cuid())
  providerKey String
  status      String   @default("unknown")
  checkedAt   DateTime @default(now())
  latencyMs   Int?
  message     String?
  metadata    String?

  @@index([providerKey, checkedAt])
}

model SavedView {
  id         String   @id @default(cuid())
  userId     String
  name       String
  area       String
  filterJson String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, area])
}

model ExportJob {
  id         String    @id @default(cuid())
  userId     String
  area       String
  state      String    @default("queued")
  filterJson String?
  objectKey  String?
  expiresAt  DateTime?
  errorCode  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId, state])
  @@index([expiresAt])
}

model FeatureFlag {
  id             String   @id @default(cuid())
  key            String
  institutionId  String?
  environment    String   @default("all")
  enabled        Boolean  @default(false)
  rolloutPercent Int?
  cohortJson     String?
  description    String?
  updatedById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([key, institutionId, environment])
  @@index([enabled])
}

// ============================================================
// LESSONS & LEARNING CONTENT
// ============================================================

model Lesson {
  id          String  @id @default(cuid())
  title       String
  order       Int     @default(0)
  durationMin Int     @default(10)
  topicId     String?
  topic       Topic?  @relation(fields: [topicId], references: [id])
  unitId      String?
  unit        Unit?   @relation(fields: [unitId], references: [id])

  // Five learning modes content (JSON strings)
  learnContent     String? // structured lesson: definition, purpose, concepts, examples, etc.
  simplifyContent  String? // simple English, Hinglish, Marathi, analogy
  visualiseContent String? // interactive animation config / diagram description
  practiseContent  String? // guided examples + questions
  reviseContent    String? // short notes, flashcards, formulas

  citations          String? // JSON array of source citations
  status             String    @default("draft") // draft | under_review | verified | published | archived
  version            Int       @default(1)
  createdById        String?
  submittedById      String?
  reviewedById       String?
  publishedById      String?
  submittedAt        DateTime?
  reviewedAt         DateTime?
  publishedAt        DateTime?
  parentVersionId    String?
  aiGenerated        Boolean   @default(false)
  contentHash        String?
  sourceCompleteness String?
  changeSummary      String?
  archivedAt         DateTime?

  completions        LessonCompletion[]
  questionAttempts   QuestionAttempt[]
  resources          LessonResource[]
  videoWatchProgress VideoWatchProgress[]
  quizAttempts       QuizAttempt[]
  generatedDocuments GeneratedLessonDocument[]
  contentJobs        ContentGenerationJob[]
  completionCriteria LessonCompletionCriteria?
  studyTasks         StudyTask[]
  codingChallenges   CodingChallenge[]
  codingSubmissions  CodingSubmission[]
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  @@index([status, updatedAt])
  @@index([createdById])
}

model LessonResource {
  id                 String   @id @default(cuid())
  lessonId           String
  lesson             Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  resourceId         String
  resource           Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  role               String // primary_video | alternate_video | lesson_notes | transcript | infographic | worksheet | formula_sheet | lab_demo | reference
  sortOrder          Int      @default(0)
  isPrimary          Boolean  @default(false)
  isRequired         Boolean  @default(false)
  startSeconds       Int?
  endSeconds         Int?
  coveragePercentage Int?
  verificationStatus String   @default("pending")
  status             String   @default("draft")
  sourceEvidence     String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([lessonId, resourceId, role])
  @@index([lessonId, role, status])
  @@index([resourceId])
}

model VideoChapter {
  id                 String   @id @default(cuid())
  resourceId         String
  resource           Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  title              String
  startSeconds       Int
  endSeconds         Int?
  order              Int      @default(0)
  transcriptSnippet  String?
  sourceEvidence     String?
  verificationStatus String   @default("pending")
  status             String   @default("draft")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([resourceId, startSeconds, title])
  @@index([resourceId, status])
}

model GeneratedLessonDocument {
  id                     String                 @id @default(cuid())
  lessonId               String
  lesson                 Lesson                 @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  outputResourceId       String?
  outputResource         Resource?              @relation("GeneratedDocumentOutputResource", fields: [outputResourceId], references: [id], onDelete: SetNull)
  documentType           String                 @default("lesson_notes") // lesson_notes | quick_notes | revision_sheet | formula_sheet | unit_pack | subject_handbook
  sourceVideoResourceIds String?
  sourceTranscriptHash   String?
  curriculumSourceIds    String?
  templateVersion        String
  aiProvider             String?
  aiModel                String?
  generationStatus       String                 @default("draft") // draft | generating | validation_failed | ready_for_review | approved | published | failed | archived
  validationResults      String?
  reviewerId             String?
  publisherId            String?
  generatedAt            DateTime?
  reviewedAt             DateTime?
  publishedAt            DateTime?
  storageObjectKey       String?
  htmlObjectKey          String?
  thumbnailObjectKey     String?
  pageCount              Int?
  contentHash            String?
  version                Int                    @default(1)
  contentJobs            ContentGenerationJob[]
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  @@index([lessonId, documentType, generationStatus])
  @@index([outputResourceId])
  @@index([contentHash])
}

model ContentGenerationJob {
  id                  String                   @id @default(cuid())
  lessonId            String
  lesson              Lesson                   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  generatedDocumentId String?
  generatedDocument   GeneratedLessonDocument? @relation(fields: [generatedDocumentId], references: [id], onDelete: SetNull)
  jobType             String                   @default("lesson_notes")
  state               String                   @default("queued") // queued | running | validation_failed | awaiting_review | completed | failed | cancelled
  attemptCount        Int                      @default(0)
  provider            String?
  model               String?
  templateVersion     String?
  inputSummaryJson    String?
  validationJson      String?
  errorCode           String?
  errorMessage        String?
  requestedById       String?
  reviewedById        String?
  publishedById       String?
  leaseOwner          String?
  leaseUntil          DateTime?
  startedAt           DateTime?
  completedAt         DateTime?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  @@index([state, updatedAt])
  @@index([lessonId, jobType])
  @@index([generatedDocumentId])
}

model LessonCompletionCriteria {
  id                    String   @id @default(cuid())
  lessonId              String   @unique
  lesson                Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  requiredResourceRoles String?
  minimumVideoPercent   Int      @default(0)
  requirePractice       Boolean  @default(false)
  requireQuizPass       Boolean  @default(false)
  minimumQuizScore      Int?
  requireExplicitDone   Boolean  @default(true)
  criteriaJson          String?
  status                String   @default("active")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([status])
}

// ============================================================
// QUESTIONS & EXAMS
// ============================================================

model Question {
  id                 String            @id @default(cuid())
  type               String            @default("mcq") // mcq | true_false | short_answer | long_answer | viva | code
  difficulty         String            @default("medium") // easy | medium | hard
  question           String
  options            String? // JSON array for MCQ
  correctAnswer      String? // for MCQ: index; for others: text
  explanation        String?
  hint               String?
  marks              Int               @default(1)
  negativeMark       Float             @default(0)
  topicId            String?
  topic              Topic?            @relation(fields: [topicId], references: [id])
  subjectId          String
  subject            Subject           @relation(fields: [subjectId], references: [id])
  unitNumber         Int?
  tags               String? // JSON array
  source             String? // previous_paper | generated | teacher
  year               Int?
  status             String            @default("draft")
  reviewStatus       String            @default("unreviewed")
  version            Int               @default(1)
  createdById        String?
  reviewedById       String?
  publishedById      String?
  learningOutcomeIds String?
  sourceEvidence     String?
  fingerprint        String?
  archivedAt         DateTime?
  attempts           QuestionAttempt[]
  createdAt          DateTime          @default(now())

  @@index([subjectId, unitNumber])
  @@index([topicId, difficulty])
  @@index([difficulty])
  @@index([subjectId, status])
  @@index([reviewStatus])
}

model QuestionPaper {
  id         String   @id @default(cuid())
  title      String
  subjectId  String
  year       Int?
  duration   Int      @default(180) // minutes
  totalMarks Int      @default(80)
  sections   String? // JSON
  analysis   String? // JSON: repeated topics, weightage, trends
  createdAt  DateTime @default(now())
}

// ============================================================
// USERS, ROLES, PROGRESS
// ============================================================

model User {
  id                    String    @id @default(cuid())
  email                 String    @unique
  emailVerified         DateTime?
  name                  String
  passwordHash          String?
  role                  String    @default("student") // student | cr | teacher | coordinator | moderator | reviewer | admin
  status                String    @default("active") // active | disabled
  avatar                String?
  institutionId         String?
  schemeId              String?
  semesterNumber        Int?
  branch                String?
  departmentCode        String?
  departmentName        String?
  division              String?
  rollNumber            String?
  provider              String    @default("password")
  profileComplete       Boolean   @default(false)
  assignedSubjects      String? // JSON array of subject IDs for teachers/coordinators
  isCR                  Boolean   @default(false)
  assignedBy            String?
  assignedAt            DateTime?
  preferredLang         String    @default("en") // en | hi | mr
  examDate              String? // ISO date
  // Contact + privacy fields
  phone                 String?
  photoUrl              String?
  showPhoneToClassmates Boolean   @default(false)
  showEmailToClassmates Boolean   @default(false)
  dailyMins             Int       @default(120)
  xp                    Int       @default(0)
  level                 Int       @default(1)
  streak                Int       @default(0)
  streakFreezes         Int       @default(0) // earn 1 by completing all daily quests; max 5
  lastFreezeUsedDate    String? // YYYY-MM-DD of last freeze applied
  lastActiveDate        String? // YYYY-MM-DD
  onboarded             Boolean   @default(false)
  authorityVersion      Int       @default(1)
  lastReauthenticatedAt DateTime?
  sessionsRevokedAt     DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  mastery                     UserTopicMastery[]
  lessonCompletions           LessonCompletion[]
  questionAttempts            QuestionAttempt[]
  quizAttempts                QuizAttempt[]
  revisionSchedules           RevisionSchedule[]
  revisionAttempts            RevisionAttempt[]
  studyTasks                  StudyTask[]
  studySessions               StudySession[]
  tutorSessions               TutorSession[]
  videoWatchProgress          VideoWatchProgress[]
  electiveSelections          StudentElectiveSelection[]
  codingSubmissions           CodingSubmission[]
  labProgress                 LabProgress[]
  achievements                UserAchievement[]
  contributions               Contribution[]
  bookmarks                   Bookmark[]
  recentlyViewed              RecentlyViewed[]
  notifications               Notification[]
  feedback                    Feedback[]
  xpEvents                    XpEvent[]
  accounts                    Account[]
  attendanceSessionsTaken     AttendanceSession[]
  attendanceRecords           AttendanceRecord[]
  classAsCR                   Class?           @relation("ClassCR")
  classMembershipsNew         ClassMember[]    @relation("ClassMemberUser")
  announcementsAuthored       ClassAnnouncement[]
  timetableSlotsAsTeacher     ClassTimetable[]
  sessions                    Session[]
  roleRequests                RoleRequest[]
  authorityGrants             AuthorityGrant[]        @relation("AuthorityGrantUser")
  createdAuthorityGrants      AuthorityGrant[]        @relation("AuthorityGrantCreatedBy")
  revokedAuthorityGrants      AuthorityGrant[]        @relation("AuthorityGrantRevokedBy")
  memberships                 InstitutionMembership[]
  roleAssignments             RoleAssignment[]        @relation("RoleAssignmentUser")
  assignedRoleAssignments     RoleAssignment[]        @relation("RoleAssignmentAssignedBy")
  revokedRoleAssignments      RoleAssignment[]        @relation("RoleAssignmentRevokedBy")
  teachingAssignments         TeachingAssignment[]    @relation("TeachingAssignmentTeacher")
  assignedTeachingAssignments TeachingAssignment[]    @relation("TeachingAssignmentAssignedBy")
  classMemberships            ClassMembership[]       @relation("ClassMembershipUser")
  verifiedClassMemberships    ClassMembership[]       @relation("ClassMembershipVerifiedBy")
  auditEventsAuthored         AuditEvent[]            @relation("AuditEventActor")
  auditEventsTargeted         AuditEvent[]            @relation("AuditEventTargetUser")
}

model InviteCode {
  id               String          @id @default(cuid())
  code             String          @unique
  tokenHash        String?
  role             String
  used             Boolean         @default(false)
  usedBy           String?
  usedAt           DateTime?
  createdBy        String?
  name             String?
  email            String?
  branch           String?
  institutionId    String?
  programmeId      String?
  schemeId         String?
  classGroupId     String?
  subjectId        String?
  departmentCode   String?
  departmentName   String?
  semesterNumber   Int?
  division         String?
  rollNumber       String?
  assignedSubjects String? // JSON array of subject IDs
  status           String          @default("active")
  expiresAt        DateTime?
  revokedAt        DateTime?
  revokedBy        String?
  maxUses          Int             @default(1)
  useCount         Int             @default(0)
  deliveryStatus   String?
  lastSentAt       DateTime?
  lastUsedIpHash   String?
  useEvents        String?
  authorityGrantId String?
  authorityGrant   AuthorityGrant? @relation(fields: [authorityGrantId], references: [id], onDelete: SetNull)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([role, used])
  @@index([email])
  @@index([status, expiresAt])
  @@index([institutionId, role])
  @@index([departmentCode, role])
  @@index([authorityGrantId])
}

model RoleRequest {
  id                  String          @id @default(cuid())
  userId              String
  user                User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestedRole       String
  reason              String?
  institutionId       String?
  departmentId        String?
  departmentCode      String?
  programmeId         String?
  schemeId            String?
  semesterId          String?
  subjectId           String?
  classGroupId        String?
  subjectIds          String?
  evidenceAttachments String?
  requestedExpiresAt  DateTime?
  decisionRubric      String?
  status              String          @default("pending") // pending | approved | rejected | withdrawn
  authorityGrantId    String?
  authorityGrant      AuthorityGrant? @relation(fields: [authorityGrantId], references: [id], onDelete: SetNull)
  reviewedBy          String?
  reviewedAt          DateTime?
  reviewNote          String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([userId, status])
  @@index([requestedRole, status])
  @@index([institutionId, status])
  @@index([departmentId, status])
  @@index([subjectId, status])
  @@index([authorityGrantId])
}

model RoleAuditLog {
  id           String   @id @default(cuid())
  actorUserId  String?
  targetUserId String?
  action       String
  role         String?
  scope        String?
  note         String?
  createdAt    DateTime @default(now())

  @@index([targetUserId, createdAt])
  @@index([actorUserId, createdAt])
}

model AuthorityGrant {
  id                  String               @id @default(cuid())
  userId              String
  user                User                 @relation("AuthorityGrantUser", fields: [userId], references: [id], onDelete: Cascade)
  role                String
  status              String               @default("active") // active | suspended | revoked | expired
  institutionId       String?
  institution         Institution?         @relation(fields: [institutionId], references: [id])
  departmentId        String?
  department          Department?          @relation(fields: [departmentId], references: [id])
  departmentCode      String?
  programmeId         String?
  programme           Programme?           @relation(fields: [programmeId], references: [id])
  schemeId            String?
  scheme              AcademicScheme?      @relation(fields: [schemeId], references: [id])
  semesterId          String?
  semester            Semester?            @relation(fields: [semesterId], references: [id])
  classGroupId        String?
  classGroup          ClassGroup?          @relation(fields: [classGroupId], references: [id])
  subjectId           String?
  subject             Subject?             @relation(fields: [subjectId], references: [id])
  createdById         String?
  createdBy           User?                @relation("AuthorityGrantCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  revokedById         String?
  revokedBy           User?                @relation("AuthorityGrantRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)
  startsAt            DateTime             @default(now())
  expiresAt           DateTime?
  suspendedAt         DateTime?
  revokedAt           DateTime?
  reason              String?
  source              String?
  scopeSummary        String?
  metadata            String?
  roleAssignments     RoleAssignment[]
  teachingAssignments TeachingAssignment[]
  classMemberships    ClassMembership[]
  roleRequests        RoleRequest[]
  inviteCodes         InviteCode[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([userId, status, role])
  @@index([role, status])
  @@index([institutionId, status])
  @@index([departmentId, status])
  @@index([departmentCode, status])
  @@index([classGroupId, status])
  @@index([subjectId, status])
  @@index([expiresAt])
}

model RoleAssignment {
  id               String          @id @default(cuid())
  authorityGrantId String?
  authorityGrant   AuthorityGrant? @relation(fields: [authorityGrantId], references: [id], onDelete: SetNull)
  userId           String
  user             User            @relation("RoleAssignmentUser", fields: [userId], references: [id], onDelete: Cascade)
  role             String
  status           String          @default("active") // active | expired | revoked | suspended
  institutionId    String?
  institution      Institution?    @relation(fields: [institutionId], references: [id])
  departmentId     String?
  department       Department?     @relation(fields: [departmentId], references: [id])
  departmentCode   String?
  programmeId      String?
  programme        Programme?      @relation(fields: [programmeId], references: [id])
  schemeId         String?
  scheme           AcademicScheme? @relation(fields: [schemeId], references: [id])
  semesterId       String?
  semester         Semester?       @relation(fields: [semesterId], references: [id])
  classGroupId     String?
  classGroup       ClassGroup?     @relation(fields: [classGroupId], references: [id])
  subjectId        String?
  subject          Subject?        @relation(fields: [subjectId], references: [id])
  assignedById     String?
  assignedBy       User?           @relation("RoleAssignmentAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  revokedById      String?
  revokedBy        User?           @relation("RoleAssignmentRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)
  startsAt         DateTime        @default(now())
  expiresAt        DateTime?
  revokedAt        DateTime?
  reason           String?
  suspendedAt      DateTime?
  suspendedById    String?
  restoredAt       DateTime?
  restoredById     String?
  source           String?
  metadata         String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([userId, status, role])
  @@index([authorityGrantId])
  @@index([role, status])
  @@index([institutionId, status])
  @@index([departmentId, status])
  @@index([departmentCode, status])
  @@index([classGroupId, status])
  @@index([subjectId, status])
  @@index([expiresAt])
}

model ClassGroup {
  id                  String               @id @default(cuid())
  institutionId       String
  institution         Institution          @relation(fields: [institutionId], references: [id])
  departmentId        String?
  department          Department?          @relation(fields: [departmentId], references: [id])
  programmeId         String?
  programme           Programme?           @relation(fields: [programmeId], references: [id])
  schemeId            String?
  scheme              AcademicScheme?      @relation(fields: [schemeId], references: [id])
  semesterId          String?
  semester            Semester?            @relation(fields: [semesterId], references: [id])
  name                String
  code                String?
  semesterNumber      Int?
  division            String?
  academicYear        String?
  status              String               @default("active") // active | archived
  roleAssignments     RoleAssignment[]
  authorityGrants     AuthorityGrant[]
  teachingAssignments TeachingAssignment[]
  memberships         ClassMembership[]
  electiveAllocations ClassElectiveAllocation[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@unique([institutionId, code])
  @@index([institutionId, status])
  @@index([departmentId, status])
  @@index([schemeId, semesterNumber, division])
}

model TeachingAssignment {
  id               String          @id @default(cuid())
  authorityGrantId String?
  authorityGrant   AuthorityGrant? @relation(fields: [authorityGrantId], references: [id], onDelete: SetNull)
  teacherId        String
  teacher          User            @relation("TeachingAssignmentTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  subjectId        String
  subject          Subject         @relation(fields: [subjectId], references: [id])
  classGroupId     String?
  classGroup       ClassGroup?     @relation(fields: [classGroupId], references: [id])
  institutionId    String?
  institution      Institution?    @relation(fields: [institutionId], references: [id])
  departmentId     String?
  department       Department?     @relation(fields: [departmentId], references: [id])
  assignedById     String?
  assignedBy       User?           @relation("TeachingAssignmentAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  status           String          @default("active") // active | expired | revoked | suspended
  startsAt         DateTime        @default(now())
  expiresAt        DateTime?
  revokedAt        DateTime?
  revokedById      String?
  suspendedAt      DateTime?
  reason           String?
  source           String?
  metadata         String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([teacherId, subjectId, classGroupId])
  @@index([authorityGrantId])
  @@index([teacherId, status])
  @@index([subjectId, status])
  @@index([classGroupId, status])
  @@index([departmentId, status])
}

model ClassMembership {
  id               String          @id @default(cuid())
  authorityGrantId String?
  authorityGrant   AuthorityGrant? @relation(fields: [authorityGrantId], references: [id], onDelete: SetNull)
  userId           String
  user             User            @relation("ClassMembershipUser", fields: [userId], references: [id], onDelete: Cascade)
  classGroupId     String
  classGroup       ClassGroup      @relation(fields: [classGroupId], references: [id], onDelete: Cascade)
  role             String          @default("student") // student | cr
  status           String          @default("active") // active | pending | suspended | left
  joinedAt         DateTime        @default(now())
  leftAt           DateTime?
  verifiedById     String?
  verifiedBy       User?           @relation("ClassMembershipVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  reason           String?
  source           String?
  suspendedAt      DateTime?
  metadata         String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([userId, classGroupId])
  @@index([authorityGrantId])
  @@index([classGroupId, status])
  @@index([userId, status])
}

model AuditEvent {
  id             String       @id @default(cuid())
  actorUserId    String?
  actorUser      User?        @relation("AuditEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  targetUserId   String?
  targetUser     User?        @relation("AuditEventTargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)
  institutionId  String?
  institution    Institution? @relation(fields: [institutionId], references: [id])
  departmentId   String?
  department     Department?  @relation(fields: [departmentId], references: [id])
  action         String
  entityType     String
  entityId       String?
  summary        String?
  requestId      String?
  correlationId  String?
  beforeSummary  String?
  afterSummary   String?
  riskLevel      String?
  retentionUntil DateTime?
  metadata       String?
  ipHash         String?
  userAgentHash  String?
  createdAt      DateTime     @default(now())

  @@index([actorUserId, createdAt])
  @@index([targetUserId, createdAt])
  @@index([institutionId, createdAt])
  @@index([departmentId, createdAt])
  @@index([entityType, entityId])
  @@index([action, createdAt])
  @@index([requestId])
  @@index([correlationId])
}

model RateLimitBucket {
  key       String   @id
  count     Int      @default(0)
  resetAt   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

// ============================================================
// AUTH.JS / NEXTAUTH
// ============================================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Idempotent XP ledger — server-authoritative, never client-writable.
// Total XP = sum of all XpEvent.amount for a user (cached on User.xp).
model XpEvent {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  eventType      String // lesson_complete | question_correct | question_attempt | quiz_submit | revision | coding_pass | achievement | contribution | streak
  sourceId       String? // id of the originating resource (lessonId, questionId, attemptId, achievementId, etc.)
  amount         Int // can be negative for corrections
  idempotencyKey String   @unique // prevents double-awarding for the same event
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, eventType])
}

model UserTopicMastery {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  topicId       String
  topic         Topic     @relation(fields: [topicId], references: [id])
  score         Float     @default(0) // 0-100
  state         String    @default("new") // new | learning | weak | revising | proficient | mastered
  evidenceCount Int       @default(0)
  confidence    Float     @default(0)
  lastPractised DateTime?
  nextRevision  DateTime?
  algoVersion   Int       @default(1)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([userId, topicId])
  @@index([userId, state])
}

model LessonCompletion {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  lessonId    String
  lesson      Lesson    @relation(fields: [lessonId], references: [id])
  mode        String    @default("learn") // learn | simplify | visualise | practise | revise
  progress    Float     @default(0) // 0-100
  scrollPos   Float     @default(0)
  completedAt DateTime?
  lastVisited DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, lessonId, mode])
  @@index([userId, lastVisited])
  @@index([userId, completedAt])
  @@index([completedAt])
}

model VideoWatchProgress {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId       String
  lesson         Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  resourceId     String
  resource       Resource  @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  lastSecond     Int       @default(0)
  watchedSeconds Int       @default(0)
  watchPercent   Float     @default(0)
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([userId, lessonId, resourceId])
  @@index([lessonId, resourceId])
  @@index([userId, updatedAt])
}

model QuestionAttempt {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  questionId    String
  question      Question @relation(fields: [questionId], references: [id])
  lessonId      String?
  lesson        Lesson?  @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  userAnswer    String?
  isCorrect     Boolean?
  timeTakenMs   Int      @default(0)
  hintUsed      Boolean  @default(false)
  confidence    Float    @default(0)
  attemptNumber Int      @default(1)
  context       String? // practice | chapter_test | mock_exam | diagnostic
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
  @@index([questionId])
  @@index([lessonId])
  @@index([userId, isCorrect])
}

model QuizAttempt {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id])
  subjectId      String?
  lessonId       String?
  lesson         Lesson?   @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  mode           String // practice | chapter_test | mock_exam
  unitNumbers    String? // JSON array
  // Lifecycle: 'in_progress' | 'submitted' | 'locked'. Prevents double-submit
  // and locks the attempt once scored. Audit fix DEBUG-3.
  status         String    @default("in_progress")
  // Server-held question set + safe ExamQuestionDTOs (so the client never
  // needs to re-fetch and we can re-score against the exact set on submit).
  questionsJson  String?
  totalQuestions Int       @default(0)
  correctCount   Int       @default(0)
  score          Float     @default(0)
  maxScore       Float     @default(0)
  durationMs     Int       @default(0)
  negativeMarks  Float     @default(0)
  startedAt      DateTime  @default(now())
  completedAt    DateTime?
  answersJson    String? // JSON of answers (in_progress) or scored review (submitted)

  @@index([userId, startedAt])
  @@index([userId, status])
  @@index([subjectId])
  @@index([lessonId, status])
  @@index([userId, subjectId, completedAt])
}

// ============================================================
// REVISION (SPACED REPETITION)
// ============================================================

model RevisionSchedule {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  topicId      String
  topic        Topic    @relation(fields: [topicId], references: [id])
  intervalDays Int      @default(1)
  nextDueDate  DateTime
  easeFactor   Float    @default(2.5)
  state        String   @default("new") // new | learning | weak | revising | proficient | mastered
  activityType String   @default("flashcard") // flashcard | recall | mistake_review | short_notes | formula_recall | mini_quiz
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, topicId])
  @@index([userId, nextDueDate])
}

model RevisionAttempt {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  scheduleId   String
  activityType String
  correct      Boolean
  quality      Int      @default(3) // SM-2 quality 0-5
  createdAt    DateTime @default(now())

  @@index([userId, scheduleId])
  @@index([userId, createdAt])
}

// ============================================================
// STUDY PLANNER
// ============================================================

model StudyTask {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  title         String
  description   String?
  type          String    @default("learn") // learn | study | practice | revision | lab | coding | mock_exam | buffer | rest
  subjectId     String?
  topicId       String?
  lessonId      String?
  lesson        Lesson?   @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  canonicalUrl  String?
  sourceReason  String?
  durationMins  Int       @default(30)
  scheduledDate String? // YYYY-MM-DD
  scheduledTime String? // HH:mm
  priority      Int       @default(2) // 0-4
  completed     Boolean   @default(false)
  completedAt   DateTime?
  createdAt     DateTime  @default(now())

  @@index([userId, scheduledDate])
  @@index([userId, completed])
  @@index([lessonId])
}

model StudySession {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  subjectId    String?
  activity     String // learn | practice | tutor | lab | coding | exam
  durationMins Int       @default(0)
  xpEarned     Int       @default(0)
  startedAt    DateTime  @default(now())
  endedAt      DateTime?

  @@index([userId, startedAt])
  @@index([userId, subjectId, startedAt])
  @@index([userId])
}

// ============================================================
// AI TUTOR
// ============================================================

model TutorSession {
  id         String         @id @default(cuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id])
  title      String         @default("New session")
  subjectId  String?
  unitNumber Int?
  topicId    String?
  mode       String         @default("explain_simple")
  language   String         @default("en")
  archived   Boolean        @default(false)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  messages   TutorMessage[]
  summaries  TutorSessionSummary[]
  memories   TutorMemory[]

  @@index([userId, updatedAt])
  @@index([userId, archived])
}

model TutorMessage {
  id              String       @id @default(cuid())
  sessionId       String
  session         TutorSession @relation(fields: [sessionId], references: [id])
  clientMessageId String?
  role            String // user | assistant
  content         String
  mode            String?
  groundingStatus String? // grounded | partially_grounded | general
  citations       String? // JSON array
  followUps       String? // JSON array
  feedback        String? // up | down | null
  createdAt       DateTime     @default(now())

  @@unique([sessionId, role, clientMessageId])
  @@index([sessionId, createdAt])
}

/// Compressed summary of an older portion of a tutor conversation.
/// Created when the conversation exceeds the short-term context window.
model TutorSessionSummary {
  id            String   @id @default(cuid())
  sessionId     String
  session       TutorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  /// Text summary of the covered message range
  summary       String
  /// First message index covered (inclusive)
  startIdx      Int
  /// Last message index covered (inclusive)
  endIdx        Int
  /// Approximate token count of the original messages
  originalTokens Int
  /// Token count of the summary
  summaryTokens Int
  createdAt     DateTime @default(now())

  @@index([sessionId, startIdx])
}

/// Auto-extracted memory from the conversation — goals, preferences,
/// decisions, code snippets, file references, etc. Used to enrich
/// the AI context so it "remembers" important facts.
model TutorMemory {
  id        String   @id @default(cuid())
  sessionId String
  session   TutorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  /// goal | preference | decision | code_snippet | file_ref | fact | deadline | api_key_ref | project_name | constraint | other
  category  String
  /// Short label (e.g. "User goal: learn OS scheduling")
  label     String
  /// Full content of the memory
  content   String
  /// Whether this memory is still active (soft delete)
  active    Boolean  @default(true)
  /// How important this memory is (1-5, 5 = critical)
  importance Int    @default(3)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sessionId, active, importance])
  @@index([sessionId, category])
}

// ============================================================
// CODING LAB
// ============================================================

model CodingChallenge {
  id             String   @id @default(cuid())
  title          String
  category       String // basic_syntax | classes | constructors | inheritance | polymorphism | templates | etc.
  difficulty     String   @default("easy")
  description    String
  starterCode    String?
  solutionCode   String?
  testCases      String? // JSON array of {input, expected}
  timeLimitMs    Int      @default(5000)
  memoryLimitKB  Int      @default(256000)
  subjectId      String?
  subject        Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  unitId         String?
  unit           Unit?    @relation(fields: [unitId], references: [id], onDelete: SetNull)
  topicId        String?
  topic          Topic?   @relation(fields: [topicId], references: [id], onDelete: SetNull)
  lessonId       String?
  lesson         Lesson?  @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  sourceEvidence String?
  status         String   @default("published") // draft | under_review | published | archived
  submissions    CodingSubmission[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status, category])
  @@index([subjectId, status])
  @@index([unitId, status])
  @@index([topicId, status])
  @@index([lessonId, status])
}

model CodingSubmission {
  id           String           @id @default(cuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id])
  challengeId  String?
  challenge    CodingChallenge? @relation(fields: [challengeId], references: [id], onDelete: SetNull)
  subjectId    String?
  subject      Subject?         @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  unitId       String?
  unit         Unit?            @relation(fields: [unitId], references: [id], onDelete: SetNull)
  topicId      String?
  topic        Topic?           @relation(fields: [topicId], references: [id], onDelete: SetNull)
  lessonId     String?
  lesson       Lesson?          @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  code         String
  language     String           @default("cpp")
  status       String           @default("draft") // draft | submitted | passed | failed | error
  output       String?
  compileError String?
  testResults  String? // JSON
  createdAt    DateTime         @default(now())

  @@index([userId, createdAt])
  @@index([challengeId, createdAt])
  @@index([subjectId, createdAt])
  @@index([lessonId, createdAt])
}

// ============================================================
// LAB PROGRESS
// ============================================================

model LabProgress {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  labType      String // ds_visualizer | cpp_lab | mp8086_sim | dc_lab
  experimentId String?
  status       String    @default("not_started") // not_started | in_progress | completed
  progress     Float     @default(0)
  lastVisited  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([userId, labType, experimentId])
}

// ============================================================
// MATERIALS & CONTRIBUTIONS
// ============================================================

model Resource {
  id                  String                    @id @default(cuid())
  title               String
  type                String // pdf | docx | image | text | video_link | web_link | code | lab_manual | question_paper | model_answer
  url                 String?
  provider            String?
  canonicalUrl        String?
  externalId          String?
  thumbnailUrl        String?
  durationSeconds     Int?
  content             String?
  subjectId           String
  subject             Subject                   @relation(fields: [subjectId], references: [id])
  unitNumber          Int?
  topicId             String?
  source              String                    @default("platform") // platform | drive | teacher | student
  visibility          String                    @default("public") // public | private | submitted | published
  verified            Boolean                   @default(false)
  contributorId       String?
  year                Int?
  language            String                    @default("en")
  difficulty          String?
  license             String?
  creator             String?
  publishedAt         DateTime?
  lastMetadataCheckAt DateTime?
  linkHealth          String                    @default("unknown")
  redirectUrl         String?
  reviewStatus        String                    @default("pending")
  reviewedById        String?
  reviewedAt          DateTime?
  qualityScore        Int?
  qualityRubricJson   String?
  sourceTrust         String?
  moderationStatus    String                    @default("clear")
  archivedAt          DateTime?
  downloads           Int                       @default(0)
  rating              Float                     @default(0)
  lessonResources     LessonResource[]
  videoChapters       VideoChapter[]
  videoWatchProgress  VideoWatchProgress[]
  generatedDocuments  GeneratedLessonDocument[] @relation("GeneratedDocumentOutputResource")
  topicMappings       ResourceTopicMapping[]
  reviews             ResourceReview[]
  createdAt           DateTime                  @default(now())

  @@index([subjectId, visibility])
  @@index([contributorId])
  @@index([provider, externalId])
  @@index([canonicalUrl])
  @@index([reviewStatus, linkHealth])
}

model Contribution {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  title         String
  type          String
  subjectId     String?
  unitNumber    Int?
  topicId       String?
  content       String?
  fileUrl       String?
  status        String   @default("draft") // draft | submitted | under_review | requires_changes | approved | rejected | archived
  moderatorNote String?
  reviewerId    String?
  rating        Float    @default(0)
  reports       Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, status])
  @@index([status])
}

model Bookmark {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  resourceType String // resource | lesson | question | topic
  resourceId   String
  label        String?
  createdAt    DateTime @default(now())

  @@unique([userId, resourceType, resourceId])
}

// ============================================================
// GAMIFICATION
// ============================================================

model Achievement {
  id               String            @id @default(cuid())
  key              String            @unique
  name             String
  description      String
  icon             String
  category         String // learning | practice | revision | coding | contribution | consistency
  xpReward         Int               @default(50)
  criteria         String? // JSON criteria
  userAchievements UserAchievement[]
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id])
  earnedAt      DateTime    @default(now())

  @@unique([userId, achievementId])
}

// ============================================================
// INDEXES (added for common query patterns — audit finding 8.2)
// ============================================================

// Note: SQLite indexes added via @@index directives on models above.
// Key query patterns indexed:
//   - XpEvent: [userId, createdAt], [userId, eventType]
//   - RevisionSchedule: [userId, nextDueDate] via @@unique([userId, topicId]) + query filter
//   - QuestionAttempt: [userId, createdAt] for history
//   - QuizAttempt: [userId, startedAt] for history
//   - TutorSession: [userId, updatedAt] for session list
//   - Resource: [subjectId, visibility] for public browsing
//   - StudyTask: [userId, scheduledDate] for planner

model InstitutionMembership {
  id                 String    @id @default(cuid())
  userId             String
  institutionId      String
  status             String    @default("unverified") // unverified | pending | verified | suspended | revoked
  programmeId        String?
  schemeId           String?
  semesterId         String?
  division           String?
  rollNumber         String?
  verificationMethod String? // admin_approval | roster_import | verified_roll_match
  verifiedBy         String?
  verifiedAt         DateTime?
  suspendedAt        DateTime?
  revokedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution Institution @relation(fields: [institutionId], references: [id])

  @@unique([userId, institutionId])
  @@index([institutionId, status])
  @@index([institutionId, rollNumber])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
}

// ============================================================
// RECENTLY VIEWED (Phase 19: continue-learning persistence)
// ============================================================

model RecentlyViewed {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resourceType String   // lesson | subject | resource
  resourceId   String
  title        String
  href         String
  scrollPos    Float    @default(0)
  viewedAt     DateTime @default(now())

  @@unique([userId, resourceType, resourceId])
  @@index([userId, viewedAt])
}

// ============================================================
// NOTIFICATIONS (Phase B6.1: in-app notification center)
// ============================================================

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String    // achievement_unlocked | buddy_request | streak_warning | group_mention | system | feedback_reply
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

// ============================================================
// FEEDBACK (Phase B10.3: in-app feedback widget)
// ============================================================

model Feedback {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating      Int       // 1-5
  type        String    // bug | idea | praise | question
  description String
  screenshot  String?   // base64 or URL
  pageUrl     String?
  userAgent   String?
  status      String    @default("new") // new | in_progress | resolved | closed
  reply       String?
  repliedBy   String?
  repliedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

// ============================================================
// ATTENDANCE SYSTEM
// ============================================================

model AttendanceSession {
  id            String   @id @default(cuid())
  takenById     String   // CR or teacher who took attendance
  takenBy       User     @relation(fields: [takenById], references: [id], onDelete: Cascade)
  departmentCode String
  semesterNumber Int
  division       String
  subjectCode   String?
  subjectName   String?
  date          DateTime @default(now()) // date of the class
  totalStudents Int      @default(0)
  presentCount  Int      @default(0)
  absentCount   Int      @default(0)
  notes         String?
  createdAt     DateTime @default(now())

  records       AttendanceRecord[]

  @@index([departmentCode, semesterNumber, division, date])
  @@index([takenById, createdAt])
}

model AttendanceRecord {
  id            String   @id @default(cuid())
  sessionId     String
  session       AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status        String   // present | absent | late | excused
  remark        String?
  createdAt     DateTime @default(now())

  @@unique([sessionId, userId])
  @@index([userId, createdAt])
  @@index([sessionId])
}

// ============================================================
// CLASS SYSTEM
// ============================================================

model Class {
  id              String   @id @default(cuid())
  departmentCode  String   // DCOMP, DCIOT
  semesterNumber  Int      // 1-6
  division        String   // A, B, C
  crId            String?  @unique // CR user ID
  cr              User?    @relation("ClassCR", fields: [crId], references: [id], onDelete: SetNull)
  academicYear    String?  // e.g. "2025-2026"
  room            String?  // default classroom
  alias           String?  // Friendly name, e.g. "Toppers of 2026"
  avatarEmoji     String?  // Single emoji, e.g. "🚀"
  avatarColor     String?  // Hex color, e.g. "#7C3AED"
  aliasUpdatedBy  String?
  aliasUpdatedAt  DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  members         ClassMember[]
  announcements   ClassAnnouncement[]
  timetableSlots  ClassTimetable[]

  @@unique([departmentCode, semesterNumber, division])
  @@index([departmentCode, semesterNumber])
}

model ClassMember {
  id        String   @id @default(cuid())
  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("ClassMemberUser", fields: [userId], references: [id], onDelete: Cascade)
  joinedAt  DateTime @default(now())

  @@unique([classId, userId])
  @@index([userId])
}

model ClassAnnouncement {
  id           String   @id @default(cuid())
  classId      String
  class        Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  authorId     String
  author       User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title        String
  body         String
  pinned       Boolean  @default(false)
  pinnedUntil  DateTime?
  archivedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([classId, createdAt])
  @@index([classId, pinned, pinnedUntil])
  @@index([authorId])
}

model ClassTimetable {
  id           String   @id @default(cuid())
  classId      String
  class        Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  dayOfWeek    Int      // 0=Sun, 1=Mon, ..., 6=Sat
  periodIndex  Int      // 1-based period number
  subjectName  String?
  teacherId    String?
  teacher      User?    @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  room         String?
  startTime    String   // "09:00"
  endTime      String   // "10:00"
  isBreak      Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([classId, dayOfWeek, periodIndex])
  @@index([classId, dayOfWeek])
  @@index([teacherId, dayOfWeek])
}
