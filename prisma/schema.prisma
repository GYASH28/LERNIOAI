// Lernio AI 2.0 — Prisma Schema
// Comprehensive academic learning platform data model

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ACADEMIC HIERARCHY
// ============================================================

model Institution {
  id                  String                  @id @default(cuid())
  name                String
  code                String                  @unique
  city                String?
  createdAt           DateTime                @default(now())
  departments         Department[]
  schemes             AcademicScheme[]
  courseCatalog       CourseCatalog[]
  memberships         InstitutionMembership[]
  classGroups         ClassGroup[]
  roleAssignments     RoleAssignment[]
  teachingAssignments TeachingAssignment[]
  auditEvents         AuditEvent[]
}

model Department {
  id                  String               @id @default(cuid())
  name                String               @default("")
  code                String
  institutionId       String
  institution         Institution          @relation(fields: [institutionId], references: [id])
  officialUrl         String?
  category            String?
  status              String               @default("active")
  metadata            String?
  sourceVerifiedAt    DateTime?
  archivedAt          DateTime?
  programmes          Programme[]
  classGroups         ClassGroup[]
  roleAssignments     RoleAssignment[]
  teachingAssignments TeachingAssignment[]
  auditEvents         AuditEvent[]
  createdAt           DateTime             @default(now())

  @@unique([institutionId, code])
}

model Programme {
  id                String           @id @default(cuid())
  name              String
  code              String
  departmentId      String
  department        Department       @relation(fields: [departmentId], references: [id])
  durationSemesters Int?
  status            String           @default("active")
  intake            Int?
  intakeNote        String?
  metadata          String?
  archivedAt        DateTime?
  schemes           AcademicScheme[]
  classGroups       ClassGroup[]
  roleAssignments   RoleAssignment[]
  createdAt         DateTime         @default(now())

  @@unique([departmentId, code])
}

model AcademicScheme {
  id                 String           @id @default(cuid())
  name               String // e.g. "G Scheme 2023"
  code               String
  institutionId      String
  institution        Institution      @relation(fields: [institutionId], references: [id])
  programmeId        String?
  programme          Programme?       @relation(fields: [programmeId], references: [id])
  startYear          Int
  endYear            Int?
  revisionLabel      String?
  status             String           @default("draft")
  effectiveFrom      DateTime?
  effectiveTo        DateTime?
  publishedVersionId String?
  sourceCoverage     String?
  archivedAt         DateTime?
  semesters          Semester[]
  subjects           Subject[]
  classGroups        ClassGroup[]
  roleAssignments    RoleAssignment[]
  createdAt          DateTime         @default(now())
}

model Semester {
  id              String           @id @default(cuid())
  number          Int
  name            String // "Semester 3"
  subtitle        String?
  color           String           @default("#7c3aed")
  schemeId        String
  scheme          AcademicScheme   @relation(fields: [schemeId], references: [id])
  subjects        Subject[]
  classGroups     ClassGroup[]
  roleAssignments RoleAssignment[]
  createdAt       DateTime         @default(now())

  @@unique([schemeId, number])
}

// ============================================================
// SUBJECTS, UNITS, TOPICS
// ============================================================

model Subject {
  id                    String                 @id @default(cuid())
  code                  String // e.g. "CS201"
  name                  String // e.g. "Data Structures"
  shortName             String?
  courseCatalogId       String?
  courseCatalog         CourseCatalog?         @relation(fields: [courseCatalogId], references: [id], onDelete: SetNull)
  credits               Int                    @default(4)
  category              String?
  lectureHours          Int?
  tutorialHours         Int?
  practicalHours        Int?
  totalHours            Int?
  assessmentMetadata    String?
  electiveGroupId       String?
  electiveGroup         ElectiveGroup?         @relation(fields: [electiveGroupId], references: [id], onDelete: SetNull)
  sourceEvidence        String?
  status                String                 @default("active")
  reviewStatus          String                 @default("draft")
  publishedAt           DateTime?
  archivedAt            DateTime?
  icon                  String?
  accentColor           String                 @default("#7c3aed")
  mascotKey             String? // leo | byte | coda | pico | nova
  description           String?
  semesterId            String
  semester              Semester               @relation(fields: [semesterId], references: [id])
  schemeId              String
  scheme                AcademicScheme         @relation(fields: [schemeId], references: [id])
  units                 Unit[]
  questions             Question[]
  resources             Resource[]
  electiveOptions       ElectiveOption[]
  courseOutcomes        CourseOutcome[]
  practicalExperiments  PracticalExperiment[]
  recommendedReferences RecommendedReference[]
  roleAssignments       RoleAssignment[]
  teachingAssignments   TeachingAssignment[]
  createdAt             DateTime               @default(now())

  @@unique([schemeId, code])
  @@index([courseCatalogId])
  @@index([electiveGroupId])
  @@index([schemeId, status])
}

model Unit {
  id                    String                 @id @default(cuid())
  number                Int
  title                 String
  description           String?
  weightage             Int                    @default(0) // exam weightage %
  outcomes              String?
  sourceEvidence        String?
  status                String                 @default("active")
  version               Int                    @default(1)
  archivedAt            DateTime?
  subjectId             String
  subject               Subject                @relation(fields: [subjectId], references: [id])
  topics                Topic[]
  lessons               Lesson[]
  practicalExperiments  PracticalExperiment[]
  recommendedReferences RecommendedReference[]
  createdAt             DateTime               @default(now())

  @@unique([subjectId, number])
}

model Topic {
  id                    String                 @id @default(cuid())
  slug                  String
  title                 String
  description           String?
  difficulty            String                 @default("medium") // easy | medium | hard
  examWeightage         Int                    @default(0)
  prerequisites         String? // JSON array of topic IDs
  outcomes              String?
  sourceEvidence        String?
  status                String                 @default("active")
  version               Int                    @default(1)
  archivedAt            DateTime?
  unitId                String
  unit                  Unit                   @relation(fields: [unitId], references: [id])
  lessons               Lesson[]
  questions             Question[]
  resourceMappings      ResourceTopicMapping[]
  recommendedReferences RecommendedReference[]
  mastery               UserTopicMastery[]
  revision              RevisionSchedule[]
  createdAt             DateTime               @default(now())

  @@unique([unitId, slug])
}

// ============================================================
// CWIT LEARNING OS DATA FOUNDATION
// ============================================================

model CourseCatalog {
  id             String       @id @default(cuid())
  institutionId  String?
  institution    Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  canonicalTitle String
  discipline     String?
  description    String?
  keywords       String?
  aliases        String?
  active         Boolean      @default(true)
  sourceEvidence String?
  subjects       Subject[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([institutionId, canonicalTitle])
  @@index([discipline, active])
}

model ElectiveGroup {
  id             String           @id @default(cuid())
  institutionId  String?
  departmentId   String?
  programmeId    String?
  schemeId       String?
  semesterId     String?
  name           String
  code           String?
  minSelect      Int              @default(1)
  maxSelect      Int              @default(1)
  status         String           @default("draft")
  sourceEvidence String?
  subjects       Subject[]
  options        ElectiveOption[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([schemeId, semesterId, status])
  @@index([programmeId, status])
}

model ElectiveOption {
  id              String        @id @default(cuid())
  electiveGroupId String
  electiveGroup   ElectiveGroup @relation(fields: [electiveGroupId], references: [id], onDelete: Cascade)
  subjectId       String?
  subject         Subject?      @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  label           String
  code            String?
  order           Int           @default(0)
  status          String        @default("active")
  sourceEvidence  String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([electiveGroupId, code])
  @@index([subjectId])
}

model SubjectApplicability {
  id                String   @id @default(cuid())
  subjectId         String
  institutionId     String?
  departmentId      String?
  programmeId       String?
  schemeId          String?
  semesterId        String?
  classGroupId      String?
  applicabilityType String   @default("offering") // offering | foundation | shared | elective
  status            String   @default("active")
  sourceEvidence    String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([subjectId, status])
  @@index([programmeId, schemeId, semesterId])
}

model CourseOutcome {
  id             String   @id @default(cuid())
  subjectId      String
  subject        Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  code           String
  text           String
  order          Int      @default(0)
  bloomLevel     String?
  sourceEvidence String?
  status         String   @default("draft")
  version        Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([subjectId, code])
  @@index([subjectId, status])
}

model ProgrammeOutcome {
  id             String   @id @default(cuid())
  programmeId    String
  code           String
  text           String
  order          Int      @default(0)
  sourceEvidence String?
  status         String   @default("active")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([programmeId, code])
  @@index([programmeId, status])
}

model OutcomeMapping {
  id                 String   @id @default(cuid())
  courseOutcomeId    String?
  programmeOutcomeId String?
  subjectId          String?
  strength           String   @default("introduced") // introduced | reinforced | mastered
  sourceEvidence     String?
  status             String   @default("draft")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([courseOutcomeId])
  @@index([programmeOutcomeId])
  @@index([subjectId, status])
}

model PracticalExperiment {
  id             String   @id @default(cuid())
  subjectId      String
  subject        Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  unitId         String?
  unit           Unit?    @relation(fields: [unitId], references: [id], onDelete: SetNull)
  title          String
  objective      String?
  apparatus      String?
  software       String?
  procedure      String?
  resultRubric   String?
  safety         String?
  order          Int      @default(0)
  sourceEvidence String?
  status         String   @default("draft")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([subjectId, status])
  @@index([unitId])
}

model RecommendedReference {
  id             String   @id @default(cuid())
  subjectId      String
  subject        Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  unitId         String?
  unit           Unit?    @relation(fields: [unitId], references: [id], onDelete: SetNull)
  topicId        String?
  topic          Topic?   @relation(fields: [topicId], references: [id], onDelete: SetNull)
  title          String
  author         String?
  publisher      String?
  edition        String?
  isbn           String?
  url            String?
  referenceType  String   @default("book")
  sourceEvidence String?
  status         String   @default("active")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([subjectId, status])
  @@index([topicId])
}

model SyllabusDocument {
  id            String              @id @default(cuid())
  institutionId String
  departmentId  String?
  programmeId   String?
  schemeId      String?
  title         String
  sourceType    String
  sourceUrl     String?
  objectKey     String?
  revisionLabel String?
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  checksum      String?
  mimeType      String?
  pageCount     Int?
  trustLevel    String              @default("official")
  status        String              @default("registered")
  uploadedById  String?
  approvedById  String?
  approvedAt    DateTime?
  notes         String?
  snapshots     SourceSnapshot[]
  importJobs    SyllabusImportJob[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([institutionId, status])
  @@index([departmentId, status])
  @@index([programmeId, schemeId])
  @@index([checksum])
}

model SourceSnapshot {
  id                 String           @id @default(cuid())
  syllabusDocumentId String
  syllabusDocument   SyllabusDocument @relation(fields: [syllabusDocumentId], references: [id], onDelete: Cascade)
  sourceUrl          String?
  objectKey          String?
  checksum           String
  mimeType           String?
  byteSize           Int?
  pageCount          Int?
  fetchStatus        String           @default("stored")
  fetchMetadata      String?
  fetchedAt          DateTime         @default(now())
  createdById        String?

  @@unique([syllabusDocumentId, checksum])
  @@index([checksum])
  @@index([fetchStatus, fetchedAt])
}

model SyllabusImportJob {
  id                  String           @id @default(cuid())
  syllabusDocumentId  String
  syllabusDocument    SyllabusDocument @relation(fields: [syllabusDocumentId], references: [id], onDelete: Cascade)
  sourceSnapshotId    String?
  state               String           @default("queued")
  parserVersion       String
  attemptCount        Int              @default(0)
  leaseOwner          String?
  leaseUntil          DateTime?
  logs                String?
  warnings            String?
  errorCode           String?
  extractedJson       String?
  normalizedDraftJson String?
  resultSummary       String?
  requestedById       String?
  reviewedById        String?
  reviewedAt          DateTime?
  findings            ImportFinding[]
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([state, updatedAt])
  @@index([syllabusDocumentId, createdAt])
}

model ImportFinding {
  id               String            @id @default(cuid())
  importJobId      String
  importJob        SyllabusImportJob @relation(fields: [importJobId], references: [id], onDelete: Cascade)
  severity         String            @default("warning")
  code             String
  message          String
  pageNumber       Int?
  rowKey           String?
  fieldPath        String?
  confidence       Float?
  resolutionStatus String            @default("open")
  resolvedById     String?
  resolvedAt       DateTime?
  createdAt        DateTime          @default(now())

  @@index([importJobId, severity])
  @@index([resolutionStatus])
}

model CurriculumVersion {
  id               String    @id @default(cuid())
  institutionId    String
  departmentId     String?
  programmeId      String?
  schemeId         String?
  subjectId        String?
  version          Int       @default(1)
  status           String    @default("draft")
  parentVersionId  String?
  sourceSnapshotId String?
  semanticDiffJson String?
  changeSummary    String?
  createdById      String?
  submittedById    String?
  reviewedById     String?
  publishedById    String?
  submittedAt      DateTime?
  reviewedAt       DateTime?
  publishedAt      DateTime?
  archivedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([schemeId, subjectId, version])
  @@index([schemeId, status])
  @@index([subjectId, status])
}

model ResourceTopicMapping {
  id                 String    @id @default(cuid())
  resourceId         String
  resource           Resource  @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  topicId            String
  topic              Topic     @relation(fields: [topicId], references: [id], onDelete: Cascade)
  coverageType       String    @default("explains")
  coveragePercent    Int?
  priority           Int       @default(0)
  startOffsetSeconds Int?
  endOffsetSeconds   Int?
  mappingNote        String?
  status             String    @default("pending")
  reviewerEvidence   String?
  reviewedById       String?
  reviewedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([resourceId, topicId, coverageType])
  @@index([topicId, status])
  @@index([resourceId, status])
}

model ResourceProvider {
  id                String    @id @default(cuid())
  institutionId     String?
  key               String
  name              String
  providerType      String
  baseUrl           String?
  policyJson        String?
  status            String    @default("active")
  lastHealthCheckAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([institutionId, key])
  @@index([status])
}

model ResourceReview {
  id         String   @id @default(cuid())
  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  reviewerId String?
  decision   String   @default("pending")
  rubricJson String?
  note       String?
  evidence   String?
  createdAt  DateTime @default(now())

  @@index([resourceId, createdAt])
  @@index([decision, createdAt])
}

model ReviewDecision {
  id          String   @id @default(cuid())
  entityType  String
  entityId    String
  reviewerId  String?
  decision    String
  note        String?
  rubricJson  String?
  priorStatus String?
  nextStatus  String?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([decision, createdAt])
}

model AssessmentBlueprint {
  id                       String   @id @default(cuid())
  subjectId                String
  title                    String
  unitScopeJson            String?
  difficultyDistribution   String?
  marksDistribution        String?
  questionTypeDistribution String?
  outcomeScopeJson         String?
  validationSummary        String?
  status                   String   @default("draft")
  createdById              String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@index([subjectId, status])
}

model FormalAssessment {
  id            String    @id @default(cuid())
  blueprintId   String?
  subjectId     String
  title         String
  status        String    @default("draft")
  opensAt       DateTime?
  closesAt      DateTime?
  snapshotJson  String?
  createdById   String?
  publishedById String?
  publishedAt   DateTime?
  archivedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([subjectId, status])
  @@index([opensAt, closesAt])
}

model AssessmentAssignment {
  id           String    @id @default(cuid())
  assessmentId String
  classGroupId String?
  userId       String?
  status       String    @default("assigned")
  assignedById String?
  assignedAt   DateTime  @default(now())
  dueAt        DateTime?

  @@index([assessmentId, status])
  @@index([classGroupId, status])
  @@index([userId, status])
}

model Notice {
  id              String           @id @default(cuid())
  title           String
  body            String
  authorId        String?
  status          String           @default("draft")
  startsAt        DateTime?
  expiresAt       DateTime?
  audienceTargets AudienceTarget[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([status, startsAt])
}

model AudienceTarget {
  id            String  @id @default(cuid())
  noticeId      String
  notice        Notice  @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  institutionId String?
  departmentId  String?
  programmeId   String?
  schemeId      String?
  semesterId    String?
  classGroupId  String?
  subjectId     String?
  role          String?

  @@index([noticeId])
  @@index([institutionId, role])
}

model JobRun {
  id           String    @id @default(cuid())
  key          String
  jobType      String
  state        String    @default("queued")
  attemptCount Int       @default(0)
  leaseOwner   String?
  leaseUntil   DateTime?
  inputJson    String?
  outputJson   String?
  errorCode    String?
  logs         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([jobType, state])
  @@index([state, updatedAt])
}

model IntegrationHealth {
  id          String   @id @default(cuid())
  providerKey String
  status      String   @default("unknown")
  checkedAt   DateTime @default(now())
  latencyMs   Int?
  message     String?
  metadata    String?

  @@index([providerKey, checkedAt])
}

model SavedView {
  id         String   @id @default(cuid())
  userId     String
  name       String
  area       String
  filterJson String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, area])
}

model ExportJob {
  id         String    @id @default(cuid())
  userId     String
  area       String
  state      String    @default("queued")
  filterJson String?
  objectKey  String?
  expiresAt  DateTime?
  errorCode  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId, state])
  @@index([expiresAt])
}

model FeatureFlag {
  id             String   @id @default(cuid())
  key            String
  institutionId  String?
  environment    String   @default("all")
  enabled        Boolean  @default(false)
  rolloutPercent Int?
  cohortJson     String?
  description    String?
  updatedById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([key, institutionId, environment])
  @@index([enabled])
}

// ============================================================
// LESSONS & LEARNING CONTENT
// ============================================================

model Lesson {
  id          String  @id @default(cuid())
  title       String
  order       Int     @default(0)
  durationMin Int     @default(10)
  topicId     String?
  topic       Topic?  @relation(fields: [topicId], references: [id])
  unitId      String?
  unit        Unit?   @relation(fields: [unitId], references: [id])

  // Five learning modes content (JSON strings)
  learnContent     String? // structured lesson: definition, purpose, concepts, examples, etc.
  simplifyContent  String? // simple English, Hinglish, Marathi, analogy
  visualiseContent String? // interactive animation config / diagram description
  practiseContent  String? // guided examples + questions
  reviseContent    String? // short notes, flashcards, formulas

  citations          String? // JSON array of source citations
  status             String    @default("published") // draft | under_review | verified | published | archived
  version            Int       @default(1)
  createdById        String?
  submittedById      String?
  reviewedById       String?
  publishedById      String?
  submittedAt        DateTime?
  reviewedAt         DateTime?
  publishedAt        DateTime?
  parentVersionId    String?
  aiGenerated        Boolean   @default(false)
  contentHash        String?
  sourceCompleteness String?
  changeSummary      String?
  archivedAt         DateTime?

  completions LessonCompletion[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([status, updatedAt])
  @@index([createdById])
}

// ============================================================
// QUESTIONS & EXAMS
// ============================================================

model Question {
  id                 String            @id @default(cuid())
  type               String            @default("mcq") // mcq | true_false | short_answer | long_answer | viva | code
  difficulty         String            @default("medium") // easy | medium | hard
  question           String
  options            String? // JSON array for MCQ
  correctAnswer      String? // for MCQ: index; for others: text
  explanation        String?
  hint               String?
  marks              Int               @default(1)
  negativeMark       Float             @default(0)
  topicId            String?
  topic              Topic?            @relation(fields: [topicId], references: [id])
  subjectId          String
  subject            Subject           @relation(fields: [subjectId], references: [id])
  unitNumber         Int?
  tags               String? // JSON array
  source             String? // previous_paper | generated | teacher
  year               Int?
  status             String            @default("draft")
  reviewStatus       String            @default("unreviewed")
  version            Int               @default(1)
  createdById        String?
  reviewedById       String?
  publishedById      String?
  learningOutcomeIds String?
  sourceEvidence     String?
  fingerprint        String?
  archivedAt         DateTime?
  attempts           QuestionAttempt[]
  createdAt          DateTime          @default(now())

  @@index([subjectId, unitNumber])
  @@index([topicId, difficulty])
  @@index([difficulty])
  @@index([subjectId, status])
  @@index([reviewStatus])
}

model QuestionPaper {
  id         String   @id @default(cuid())
  title      String
  subjectId  String
  year       Int?
  duration   Int      @default(180) // minutes
  totalMarks Int      @default(80)
  sections   String? // JSON
  analysis   String? // JSON: repeated topics, weightage, trends
  createdAt  DateTime @default(now())
}

// ============================================================
// USERS, ROLES, PROGRESS
// ============================================================

model User {
  id                    String    @id @default(cuid())
  email                 String    @unique
  emailVerified         DateTime?
  name                  String
  passwordHash          String?
  role                  String    @default("student") // student | cr | teacher | coordinator | moderator | reviewer | admin
  status                String    @default("active") // active | disabled
  avatar                String?
  institutionId         String?
  schemeId              String?
  semesterNumber        Int?
  branch                String?
  departmentCode        String?
  departmentName        String?
  division              String?
  rollNumber            String?
  provider              String    @default("password")
  profileComplete       Boolean   @default(false)
  assignedSubjects      String? // JSON array of subject IDs for teachers/coordinators
  isCR                  Boolean   @default(false)
  assignedBy            String?
  assignedAt            DateTime?
  preferredLang         String    @default("en") // en | hi | mr
  examDate              String? // ISO date
  dailyMins             Int       @default(120)
  xp                    Int       @default(0)
  level                 Int       @default(1)
  streak                Int       @default(0)
